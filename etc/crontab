# /etc/crontab — system-wide cron
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
# m h dom mon dow user  command
17 * * * *  root  cd / && run-parts --report /etc/cron.hourly
25 6 * * *  root  test -x /usr/sbin/anacron && /usr/sbin/anacron -s
47 6 * * 7  root  test -x /usr/sbin/anacron && /usr/sbin/anacron -s
52 6 1 * *  root  test -x /usr/sbin/anacron && /usr/sbin/anacron -s